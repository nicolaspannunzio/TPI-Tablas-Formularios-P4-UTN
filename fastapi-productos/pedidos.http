### Variables
@baseUrl = http://127.0.0.1:8000

### 1. Crear un producto para las pruebas (201)
# @name crearProducto
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Hamburguesa Especial",
  "descripcion": "Carne premium con queso cheddar y bacon",
  "precio_base": 8500.0,
  "imagenes_url": ["https://ejemplo.com/burger.jpg"],
  "disponible": true
}

### 2. Crear segundo producto (201)
# @name crearProducto2
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Papas fritas",
  "descripcion": "Porción grande",
  "precio_base": 3200.5,
  "imagenes_url": [],
  "disponible": true
}

### 3. Crear pedido con dos detalles (201). Total = 2*8500 + 1*3200.5 = 20200.5
# @name crearPedido
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{crearProducto.response.body.id}},  "cantidad": 2 },
    { "producto_id": {{crearProducto2.response.body.id}}, "cantidad": 1 }
  ]
}

### 4. Listar pedidos no eliminados (200)
GET {{baseUrl}}/pedidos

### 5. Obtener pedido por id con sus detalles (200)
GET {{baseUrl}}/pedidos/{{crearPedido.response.body.id}}

### 6. Actualizar estado (200)
PUT {{baseUrl}}/pedidos/{{crearPedido.response.body.id}}
Content-Type: application/json

{
  "estado": "CONFIRMADO"
}

### 7. ERROR 422: producto repetido en los detalles (RN-12)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{crearProducto.response.body.id}}, "cantidad": 1 },
    { "producto_id": {{crearProducto.response.body.id}}, "cantidad": 3 }
  ]
}

### 8. ERROR 422: pedido sin detalles (RN-12)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": []
}

### 9. ERROR 422: cantidad menor que 1
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{crearProducto.response.body.id}}, "cantidad": 0 }
  ]
}

### 10. ERROR 422: estado fuera de los permitidos
PUT {{baseUrl}}/pedidos/{{crearPedido.response.body.id}}
Content-Type: application/json

{
  "estado": "EN_CAMINO"
}

### 11. ERROR 404: detalle con producto inexistente (rollback: no se guarda ni el pedido)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{crearProducto.response.body.id}}, "cantidad": 1 },
    { "producto_id": 99999, "cantidad": 1 }
  ]
}

### 12. ERROR 404: pedido inexistente
GET {{baseUrl}}/pedidos/99999

### 13. Borrado lógico (204)
DELETE {{baseUrl}}/pedidos/{{crearPedido.response.body.id}}

### 14. ERROR 404: obtener un pedido ya eliminado
GET {{baseUrl}}/pedidos/{{crearPedido.response.body.id}}

### 15. ERROR 404: actualizar un pedido ya eliminado
PUT {{baseUrl}}/pedidos/{{crearPedido.response.body.id}}
Content-Type: application/json

{
  "estado": "ENTREGADO"
}

### 16. ERROR 404: eliminar de nuevo un pedido ya eliminado
DELETE {{baseUrl}}/pedidos/{{crearPedido.response.body.id}}

### 17. El pedido eliminado ya no aparece en el listado (200)
GET {{baseUrl}}/pedidos
